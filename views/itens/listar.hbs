<header class="titulo-pagina">
  <p class="rotulo">Achados e Perdidos</p>

  <h1>{{titulo}}</h1>

  <p>{{descricao}}</p>

  <p class="contador">
    <strong>{{quantidade}}</strong>
    item(ns) cadastrado(s).
  </p>
</header>

{{#if possuiItens}}
  <section class="grade" aria-label="Lista de itens perdidos e encontrados">
    {{#each itens}}
      {{> cartao-item}}
    {{/each}}
  </section>
{{else}}
  <section class="estado-vazio">
    <h2>Nenhum item cadastrado</h2>
    <p>
      Ainda não há objetos perdidos ou encontrados registrados no sistema.
    </p>
  </section>
{{/if}}
