<section class="hero">
  <p class="rotulo">Sistema funcionando</p>

  <h1>{{titulo}}</h1>

  <p class="hero__subtitulo">{{subtitulo}}</p>

  <p>
    Encontre objetos perdidos ou consulte os itens encontrados.
    O sistema utiliza Node.js, Express, Sequelize, SQLite e Handlebars
    para armazenar e apresentar as informações.
  </p>

  <a class="botao" href="/itens">Consultar itens</a>
</section>

<section aria-labelledby="recentes" class="painel">
  <h2 id="recentes">Itens recentes</h2>

  {{#if destaques.length}}
    <div class="grade">
      {{#each destaques}}
        {{> cartao-item}}
      {{/each}}
    </div>
  {{else}}
    <p class="estado-vazio">Nenhum registro foi encontrado.</p>
  {{/if}}
</section>